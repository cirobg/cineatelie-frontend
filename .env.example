# Copy to .env.local for local development: `cp .env.example .env.local`.
# Everything in a Vite bundle is public (architecture doc Appendix A.2) -- only the
# publishable/anon-equivalent key belongs here, never a service-role or secret key.

VITE_APP_ENV=local
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Settings > API Keys on the Supabase project dashboard.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Must match exactly what's registered in both Supabase (Authentication > URL Configuration >
# Redirect URLs) and, indirectly, the Google Cloud Console OAuth client (which only ever
# points at Supabase's own callback, never at this URL directly).
VITE_OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback
